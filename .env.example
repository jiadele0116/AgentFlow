# LLM API Key (required)
# 变量名必须与 config.yaml 中 llm.api_key 的 ${...} 占位符一致。
# 当前配置指向 DeepSeek（provider=openai，OpenAI 兼容接口）。
DEEPSEEK_API_KEY=your-api-key-here

# Embedding API Key (RAG 需要)
# 硅基流动 SiliconFlow，注册地址 https://siliconflow.cn
# 变量名对应 config.yaml 中 embedding.api_key 的 ${...} 占位符。
SILICONFLOW_API_KEY=your-api-key-here

# 注意：本项目不会自动加载 .env 文件（未使用 python-dotenv），
# 上面的变量需要真正设置到进程环境变量中才生效，见下方说明。
#   Windows:  setx DEEPSEEK_API_KEY "sk-xxx"   （设完需重开终端）
#   Linux/macOS: export DEEPSEEK_API_KEY="sk-xxx"

# 可选：数据库连接（默认使用 SQLite，无需配置）
# DB_URL=postgresql://user:pass@localhost/dbname
